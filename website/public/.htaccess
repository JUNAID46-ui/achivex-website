# AchiveX website on Apache hosting (Hostinger and similar). Upload the contents of website/out
# to public_html together with this file.

Options -MultiViews -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use HTTPS.
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Addresses end with a slash (/about-us/), like the links on the site.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5}|/)$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

# Anything without its own file opens the website, which shows the right page or the 404 page.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https://pktnqerzatrdndhbtsqp.supabase.co wss://pktnqerzatrdndhbtsqp.supabase.co; frame-src https://www.google.com https://maps.google.com; frame-ancestors 'self' https://achivex-admin.vercel.app https://admin.achivex.com; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  # Build files have a content hash in their name, so they can be cached for a year.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
