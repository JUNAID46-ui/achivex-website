APP_NAME="AchiveX Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# The public website. Used for "Visit site", the page builder preview and sitemap links.
SITE_URL=http://localhost:5173
SITE_PUBLIC_URL=https://www.achivex.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Supabase Postgres. In Supabase click "Connect" and copy the Session pooler values.
DB_CONNECTION=pgsql
DB_HOST=aws-0-us-west-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.pktnqerzatrdndhbtsqp
DB_PASSWORD=
DB_SSLMODE=require
DB_SEARCH_PATH=admin,public

SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log

# Email over SMTP (Gmail). MAIL_PASSWORD must be a Gmail App Password:
# Google Account, Security, 2-Step Verification on, then App passwords.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="AchiveX LLC"

# First administrator account, created by "php artisan achivex:install"
ADMIN_NAME="Site Admin"
ADMIN_EMAIL=your-email@gmail.com
ADMIN_PASSWORD=

# Rebuilds the website after content changes (Vercel: Project Settings, Git, Deploy Hooks).
SITE_DEPLOY_HOOK=
# Hostinger: build the website on this server (see docs/HOSTINGER-MOVE.md).
SITE_BUILD=
SITE_PUBLIC_PATH=
SITE_SOURCE_PATH=
SITE_NPM=npm
